{
  "expo": {
    "name": "Rizo",
    "slug": "rizo-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_square.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo_with_margin.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rizo.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rizo needs access to your location for attendance punching and visit tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Rizo needs access to your location for attendance punching and visit tracking even in background."
      }
    },
    "android": {
      "package": "com.rizo.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_square.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/logo_with_margin.png"
    },
    "plugins": [
      [
        "expo-sqlite"
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Rizo to use your location for attendance tracking."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "memory": 4096,
            "newArchEnabled": false
          }
        }
      ],
      "expo-camera",
      "expo-image-picker",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "adfbeacf-66c4-4181-8a8a-b61ca6e1abb2"
      }
    },
    "owner": "bindhuv"
  }
}
