{
  "expo": {
    "name": "Rizo",
    "slug": "rizo-app",
    "version": "1.0.3",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/icon_square.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo_with_margin.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rizo.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rizo needs access to your location for attendance punching and visit tracking."
      }
    },
    "android": {
      "package": "com.rizo.mobile",
      "versionCode": 8,
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION"],
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_square.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/logo_with_margin.png"
    },
    "plugins": [
      "./plugins/withAgpCompatibility",
      "expo-sqlite",
      ["expo-location", {
        "isAndroidBackgroundLocationEnabled": false
      }],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.21"
          }
        }
      ],
      "expo-notifications",
      "expo-camera",
      "expo-image-picker",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "beed38ea-7f0d-4ffe-8cbe-85e070b8b4a1"
      }
    },
    "owner": "bindu_01"
  }
}
