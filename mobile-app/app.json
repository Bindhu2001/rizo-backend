{
  "expo": {
    "name": "Rizo",
    "slug": "rizo",
    "version": "1.0.7",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/icon_square.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rizo.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rizo needs access to your location for attendance punching and visit tracking.",
        "NSCameraUsageDescription": "Rizo needs camera access to take your attendance selfie when you check in or out, and to capture receipts and documents for expense and leave attachments.",
        "NSPhotoLibraryUsageDescription": "Rizo needs photo library access so you can attach receipts and documents for expenses and leave requests.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.rizo.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 26,
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION"],
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_icon_foreground.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/logo_with_margin.png"
    },
    "plugins": [
      "./plugins/withAgpCompatibility",
      "./plugins/withNetworkSecurityConfig",
      ["expo-splash-screen", {
        "image": "./assets/splash_logo.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/splash_logo.png",
          "backgroundColor": "#0F172A"
        }
      }],
      "expo-sqlite",
      ["expo-location", {
        "isAndroidBackgroundLocationEnabled": false
      }],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.21"
          }
        }
      ],
      ["expo-notifications", {
        "icon": "./assets/notification_icon.png",
        "color": "#662D91"
      }],
      "expo-camera",
      "expo-image-picker",
      "@react-native-community/datetimepicker",
      "expo-background-fetch"
    ],
    "extra": {
      "eas": {
        "projectId": "3b809a7c-1863-489e-8a15-8452631f21c0"
      }
    },
    "owner": "athiraglos"
  }
}
