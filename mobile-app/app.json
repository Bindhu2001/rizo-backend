{
  "expo": {
    "name": "Rizo",
    "slug": "rizo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_with_margin.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo_with_margin.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rizo.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rizo needs access to your location for attendance punching and visit tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Rizo needs access to your location for attendance punching and visit tracking even in background."
      }
    },
    "android": {
      "package": "com.rizo.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_with_margin.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/logo_with_margin.png"
    },
    "plugins": [
      [
        "./plugins/withAgpVersion",
        "8.7.3"
      ],
      [
        "expo-sqlite"
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Rizo to use your location for attendance tracking."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.21",
            "memory": 4096
          }
        }
      ],
      "expo-camera",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "41c4c13b-d1ca-4412-917c-53f6cd7455a6"
      }
    },
    "owner": "bindhu_v"
  }
}
