    if ($submitBtn.prop('disabled')) return;

    $submitBtn.prop('disabled', true).text('Saving...');

    let formData = new FormData(this);

    $.ajax({
        url: '/EmployeeJoin/saveDoc',
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,
        success: function(response) {
            try {
                const res = JSON.parse(response);
                if (res.status === 'success') {
                    $.notify(res.message || 'Document saved successfully!', {
                        type: 'success',
                        z_index: 99999
                    });
                } else {
                    $.notify(res.message || 'Failed to save document.', {
                        type: 'danger',
                        z_index: 99999
                    });
                }
            } catch (e) {
                $.notify('Unexpected server response.', {
                    type: 'danger',
                    z_index: 99999
                });
            } finally {
                // Reset form & modal, re-enable button, reload table
                $form[0].reset();
                $('#documentModal').modal('hide');
                loadDocumentTable();
                $submitBtn.prop('disabled', false).text('Save');
            }
        },
        error: function(xhr) {
            $.notify('Server error while saving document.', {
                type: 'danger',
                z_index: 99999
            });
            console.error(xhr.responseText);
            $submitBtn.prop('disabled', false).text('Save'); // Re-enable button
        }
    });
});


