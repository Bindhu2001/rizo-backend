<script>
document.getElementById('dob').addEventListener('change', function() {
    const dob = new Date(this.value);
    const today = new Date();
    
    if (!isNaN(dob)) {
        let age = today.getFullYear() - dob.getFullYear();
        const monthDiff = today.getMonth() - dob.getMonth();
        
        // Adjust if birthday hasn't occurred yet this year
        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
            age--;
        }

        document.getElementById('age').value = age;
    } else {
        document.getElementById('age').value = '';
    }
});
</script>


<script>
    // $(document).on('submit', 'form', function() {
    //     $(this).find('button[type=submit]').prop('disabled', true).text('Saving...');
    // });



    $(document).ready(function() {
        // Initialize both datepickers
        $("#from_date").datepicker({
            format: 'yyyy-mm-dd',
            autoclose: true
        }).on('changeDate', function(e) {
            var fromDate = e.date;


            $('#to_date').datepicker('setStartDate', fromDate);


            if (toVal && toVal < fromDate) {
                $('#to_date').datepicker('clearDates');
            }
        });

        $("#to_date").datepicker({
            format: 'yyyy-mm-dd',
            autoclose: true
        });
    });

    $(document).ready(function() {

        $("#valid_from").datepicker({
            format: 'yyyy-mm-dd',
            autoclose: true
        }).on('changeDate', function(e) {
            var fromDate = e.date;


            $('#valid_till').datepicker('setStartDate', fromDate);


            var tillDate = $('#valid_till').datepicker('getDate');
            if (tillDate && tillDate < fromDate) {
                $('#valid_till').datepicker('clearDates');
            }
        });

        $("#valid_till").datepicker({
            format: 'yyyy-mm-dd',
            autoclose: true,
            todayHighlight: true,
            startDate: new Date()
        });
    });
    document.getElementById('avatarfile').addEventListener('change', function() {
        const file = this.files[0];
        const msg = document.getElementById('avatarfile_msg');
        const nameField = document.getElementById('selected_file_name');

        if (!file) {
            msg.style.display = 'none';
            if (nameField) nameField.value = '';
            return;
        }

        const allowedTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/gif'];

        if (!allowedTypes.includes(file.type)) {
            msg.textContent = 'Only PDF and image files are allowed!';
            msg.style.display = 'block';
            this.value = ''; // clear the input
            if (nameField) nameField.value = '';
        } else {
            msg.style.display = 'none'; // valid file
            if (nameField) nameField.value = file.name;
        }
