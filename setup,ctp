    $('#educationFormModal').on('submit', function(e) {
    e.preventDefault();

    const $form = $(this);
    const $submitBtn = $form.find('button[type="submit"]');
    if ($submitBtn.prop('disabled')) return;

    $submitBtn.prop('disabled', true).text('Saving...');

    let formData = new FormData(this);

    $.ajax({
        url: '/EmployeeJoin/saveEducation',
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,
        success: function(response) {
            try {
                const res = JSON.parse(response);
                const type = res.status === 'error' ? 'danger' : 'success';
                $.notify(res.message || 'Education data saved successfully!', { type, z_index: 99999 });
            } catch (err) {
                $.notify('Unexpected server response.', { type: 'danger', z_index: 99999 });
            } finally {
                $form[0].reset();
                $('#educationModal').modal('hide');
                loadEducationTable();
                $submitBtn.prop('disabled', false).text('Save');
            }
        },
        error: function(xhr) {
            $.notify('Server error while saving education.', { type: 'danger', z_index: 99999 });
            console.error(xhr.responseText);
            $submitBtn.prop('disabled', false).text('Save');
        }
    });
});

