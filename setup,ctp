        function liveValidate(inputId, regex, message, optional = false) {
            const $input = $(inputId);
            const value = $input.val().trim();
            const $msg = $('#' + $input.attr('id') + '_msg');

            $msg.hide().text('').css('color', 'red');

            if (!value && !optional) {
                $msg.text(message).show();
                return false;
            }

            if (value && !regex.test(value)) {
                $msg.text(message).show();
                // $input.val(''); // Clear invalid input
                return false;
            }

            if (value && regex.test(value)) {
                $msg.text('Valid').css('color', 'green').show();
            }

            return true;
        }

